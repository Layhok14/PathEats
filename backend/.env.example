# ── Server Configuration ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Direct Database Connection───────────
#Only edit here first
DATABASE_URL=your_supabase_database_url_here

# ── JWT Configurations──────────────────────
JWT_ACCESS_SECRET=generate_a_random_64_char_hex_string
JWT_REFRESH_SECRET=generate_a_different_random_64_char_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── External APIs ──────────────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org

# ── SMTP Configuration ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@patheat.com

# Supabase Storage for vendor/menu/place images
# auto = use Supabase when credentials are present, otherwise keep local uploads for development
# supabase = require Supabase Storage and fail uploads if it is not configured
# local = always write files to frontend/public/uploads for development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=vendor-images
SUPABASE_STORAGE_MODE=auto

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
# Local upload directory for development (defaults to frontend/public/uploads/vendor-images)
# VENDOR_IMAGE_DIR=/path/to/your/uploads

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_STORAGE_DIR=./data/backup

# ── Database Connection (overrides) ───────────────────────────────────────────
PGSSLMODE=prefer
DB_REGION=us-east-1

# ── Bypass Flags (dev-only, set to "true" to enable) ──────────────────────────
PATHEAT_ADMIN_BYPASS=false
PATHEAT_DEV_BYPASS=false

# ── Seed Users (for dev/testing, one per role) ────────────────────────────────
# Run `node src/db/seed.js` then `node src/db/role.js` to apply these.
# role.js hashes the passwords with bcrypt and updates the database.
SEED_CONSUMER_EMAIL=consumer@patheat.app
SEED_CONSUMER_PASSWORD=change_me_consumer_2026!

SEED_VENDOR_EMAIL=vendor@patheat.app
SEED_VENDOR_PASSWORD=change_me_vendor_2026!

SEED_ADMIN_EMAIL=admin@patheat.app
SEED_ADMIN_PASSWORD=change_me_admin_2026!

SEED_DEV_EMAIL=dev@patheat.app
SEED_DEV_PASSWORD=change_me_dev_2026!

SEED_BUSINESS_EMAIL=business@patheat.app
SEED_BUSINESS_PASSWORD=change_me_business_2026!
