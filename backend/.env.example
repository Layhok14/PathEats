PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase direct PostgreSQL connection.
# Replace YOUR_PROJECT_REF and URL-encode special characters in your password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_SECRET=replace_with_the_same_or_another_long_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# External APIs
OSRM_BASE_URL=https://router.project-osrm.org

# Admin bootstrap account used by `npm run create-admin`.
ADMIN_EMAIL=admin@patheat.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=Global
ADMIN_LAST_NAME=Admin

# Optional SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@patheat.com

MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
