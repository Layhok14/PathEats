# ── Server Configuration ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Direct Database Connection───────────
#Only edit here first
DATABASE_URL=Your url here

# ── JWT Configurations──────────────────────
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── External APIs ──────────────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org

# ── SMTP Configuration ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@patheat.com

# Supabase Storage for vendor/menu/place images
# auto = use Supabase when credentials are present, otherwise keep local uploads for development
# supabase = require Supabase Storage and fail uploads if it is not configured
# local = always write files to backend/uploads for development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=vendor-images
SUPABASE_STORAGE_MODE=auto

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# ── Seed Users (for dev/testing, one per role) ────────────────────────────────
# Run `node src/db/seed.js` then `node src/db/role.js` to apply these.
# role.js hashes the passwords with bcrypt and updates the database.
SEED_CONSUMER_EMAIL=consumer@patheat.app
SEED_CONSUMER_PASSWORD=consumer123

SEED_VENDOR_EMAIL=vendor@patheat.app
SEED_VENDOR_PASSWORD=vendor123

SEED_ADMIN_EMAIL=admin@patheat.app
SEED_ADMIN_PASSWORD=admin123

SEED_DEV_EMAIL=dev@patheat.app
SEED_DEV_PASSWORD=dev123

